{
  "info": {
    "name": "EBank — Projet de synthèse",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:9999"
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Microservices",
      "item": [
        {
          "name": "Liste des clients",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/CUSTOMER-SERVICE/customers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Client 1",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/CUSTOMER-SERVICE/customers/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un client",
          "request": {
            "method": "POST",
            "url": "{{gateway}}/CUSTOMER-SERVICE/customers",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nora\",\n  \"email\": \"nora@example.test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste des comptes",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/EBANK-SERVICE/accounts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accountId', pm.response.json()[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Détail du premier compte",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/EBANK-SERVICE/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un compte",
          "request": {
            "method": "POST",
            "url": "{{gateway}}/EBANK-SERVICE/accounts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"balance\": 450.75,\n  \"type\": \"SAVING_ACCOUNT\",\n  \"customerId\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Client inexistant",
          "request": {
            "method": "POST",
            "url": "{{gateway}}/EBANK-SERVICE/accounts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"balance\": 100,\n  \"type\": \"CURRENT_ACCOUNT\",\n  \"customerId\": 9999\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Solde invalide",
          "request": {
            "method": "POST",
            "url": "{{gateway}}/EBANK-SERVICE/accounts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"balance\": -1,\n  \"type\": \"CURRENT_ACCOUNT\",\n  \"customerId\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Agent IA",
      "item": [
        {
          "name": "Demander la liste des clients",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/EBANK-BOT/chat?query=Liste%20les%20clients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Demander les comptes",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/EBANK-BOT/chat?query=Liste%20les%20comptes%20bancaires"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
